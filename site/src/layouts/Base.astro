---
import "../styles.css";
import Seo from "../components/Seo.astro";
import Header from "../components/Header.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { BLOB, NPM, REPO, UPDATED, type Faq } from "../site";

interface Props {
  path: string;
  title: string;
  description: string;
  /** Visible h1 and schema headline; defaults to title. */
  headline?: string;
  kind?: "TechArticle" | "Article";
  faq?: Faq;
  /** Optional page palette, a class on <body> (e.g. "night"). */
  theme?: string;
}
const { path, title, description, headline = title, kind = "TechArticle", faq, theme } = Astro.props;
const hero = Astro.slots.has("hero");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <Seo {path} {title} {description} {headline} {kind} {faq} />
  </head>
  <body class={theme}>
    <Header {path} />
    <slot name="hero" />
    <main>
      {!hero && <Breadcrumbs {path} {headline} />}
      <article>
        {!hero && <h1>{headline}</h1>}
        <slot />
        {faq && (
          <>
            <h2>FAQ</h2>
            {faq.map(([q, a]) => (<><h3>{q}</h3><p>{a}</p></>))}
          </>
        )}
      </article>
    </main>
    <footer>
      Reflex Quant, MIT license, by Andrii Volynets. <a href={REPO}>Source</a> · <a href={NPM}>npm</a> ·
      <a href={`${BLOB}/CONTRACT.md`}>Contract</a> · <a href={`${BLOB}/research/REPORT.md`}>Research report</a>. Last updated {UPDATED}.
    </footer>
  </body>
</html>
