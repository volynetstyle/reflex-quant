---
// Headline benchmark figures as three ratios and a scenario-count strip. Source: src/bench.ts.
import { AGG, RUN } from "../bench";
const slower = AGG.n - AGG.within25;
const rows: [string, number, string][] = [
  ["Faster than both rivals", AGG.faster, "win"],
  ["Within 25 % of the faster rival", AGG.within25, "win"],
  ["More than 25 % slower", slower, "lose"],
];
---
<div class="stats">
  <div class="stat"><b>{AGG.alien}×</b><span>of alien-signals' time (geomean)</span></div>
  <div class="stat"><b>{AGG.reflex}×</b><span>of Reflex's time</span></div>
  <div class="stat"><b>{AGG.best}×</b><span>{AGG.best >= 1 ? `only ${Math.round((AGG.best - 1) * 100)} % behind` : `${Math.round((1 - AGG.best) * 100)} % ahead of`} an oracle that picks the faster rival in every scenario (geomean)</span></div>
</div>
<figure class="strip" aria-label={`Out of ${AGG.n} scenarios`}>
  {rows.map(([label, v, cls]) => (
    <div class="strip-row">
      <span>{label}</span>
      <span class="strip-track"><span class={`strip-bar ${cls}`} style={`width:${(v / AGG.n) * 100}%`} /></span>
      <b>{v} / {AGG.n}</b>
    </div>
  ))}
  <figcaption>{AGG.n} scenarios, lower time is better. CI run <a href={RUN.url}>{RUN.id}</a>; the suite is this project's own.</figcaption>
</figure>
