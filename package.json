{
  "name": "reflex-quant",
  "version": "1.1.2",
  "description": "The smallest reactive runtime the invariants of Reflex imply: signals, computeds, effects; exact dependency tracking, no recursion, ~2 KB gzip.",
  "keywords": [
    "signals",
    "reactivity",
    "reactive",
    "computed",
    "effect",
    "fine-grained"
  ],
  "license": "MIT",
  "author": "Andrii Volynets",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volynetstyle/reflex-quant.git"
  },
  "bugs": {
    "url": "https://github.com/volynetstyle/reflex-quant/issues"
  },
  "homepage": "https://volynetstyle.github.io/reflex-quant/",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "development": "./dist/index.development.js",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "development": "./dist/index.development.cjs",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "lint": "eslint src",
    "format": "prettier --write src eslint.config.mjs .prettierrc.json",
    "format:check": "prettier --check src eslint.config.mjs .prettierrc.json",
    "test": "vitest run --config vitest.config.ts",
    "test:production": "vitest run --config vitest.config.ts --mode production",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run typecheck && npm run build && npm run check",
    "site": "npm --prefix site run build"
  },
  "devDependencies": {
    "alien-signals": "3.2.1",
    "esbuild": "^0.25.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.7.0",
    "prettier": "^3.9.10",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.5"
  }
}
