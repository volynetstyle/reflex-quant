{
  "name": "reflex-quant",
  "version": "0.1.0",
  "description": "The smallest reactive runtime the invariants of Reflex imply: signals, computeds, effects; exact dependency tracking, no recursion, ~2 KB gzip.",
  "keywords": [
    "signals",
    "reactivity",
    "reactive",
    "computed",
    "effect",
    "fine-grained"
  ],
  "license": "MIT",
  "author": "Andrii Volynets",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volynetstyle/reflex-quant.git"
  },
  "bugs": {
    "url": "https://github.com/volynetstyle/reflex-quant/issues"
  },
  "homepage": "https://github.com/volynetstyle/reflex-quant#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run typecheck && npm run build && npm run check"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
