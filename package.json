{
  "name": "reflex-quant",
  "version": "1.2.0",
  "description": "A tiny, high-performance signals library for JavaScript and TypeScript with exact dynamic dependency tracking, glitch-free propagation, stack-safe execution, and defined failure semantics.",
  "keywords": [
    "signals",
    "reactivity",
    "reactive",
    "computed",
    "effect",
    "fine-grained"
  ],
  "license": "MIT",
  "author": "Andrii Volynets",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volynetstyle/reflex-quant.git"
  },
  "bugs": {
    "url": "https://github.com/volynetstyle/reflex-quant/issues"
  },
  "homepage": "https://volynetstyle.github.io/reflex-quant/",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "development": "./dist/index.development.js",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "development": "./dist/index.development.cjs",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "lint": "eslint src",
    "format": "prettier --write src eslint.config.mjs .prettierrc.json",
    "format:check": "prettier --check src eslint.config.mjs .prettierrc.json",
    "test": "vitest run --config vitest.config.ts",
    "test:production": "vitest run --config vitest.config.ts --mode production",
    "test:history-advanced": "vitest run --config vitest.config.ts test/history-reentrant.test.ts test/history-counter-wrap.test.ts test/history-greybox.test.ts test/history-temporal-witnesses.test.ts test/history-boundaries.test.ts test/history-handoffs.test.ts",
    "test:history-boundaries": "vitest run --config vitest.config.ts test/history-boundaries.test.ts",
    "test:history-handoffs": "vitest run --config vitest.config.ts test/history-handoffs.test.ts",
    "test:transitions": "vitest run --config vitest.config.ts test/transition-system.test.ts",
    "research:transitions": "node research/transition-audit.mjs",
    "research:transition-traces": "node research/transition-traces.mjs",
    "research:handoffs": "node research/temporal-sweep.mjs --handoffs",
    "research:handoff-mutants": "node research/temporal-sweep.mjs --handoffs --mutants",
    "research:boundaries": "node research/temporal-sweep.mjs",
    "research:temporal-sweep": "node research/temporal-sweep.mjs --mutants",
    "research:scars": "node research/scar-search.mjs",
    "research:temporal-mutants": "node research/temporal-mutants.mjs",
    "research:gc": "node research/gc-history.mjs",
    "research:engine": "node research/engine-history.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:history": "node scripts/check-history.mjs",
    "prepublishOnly": "npm run typecheck && npm run build && npm run check",
    "site": "npm --prefix site run build",
    "check:bench": "node scripts/check-bench.mjs",
    "check:site": "npm run build && node bench/build.mjs && npm --prefix site run check"
  },
  "devDependencies": {
    "alien-signals": "3.2.1",
    "esbuild": "^0.25.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.7.0",
    "prettier": "^3.9.10",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.5"
  }
}
